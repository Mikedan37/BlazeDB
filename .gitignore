# Swift Package Manager
.build/
.build*
.build-codex*
.build-codex-*
.swiftpm/*
!.swiftpm/xcode
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata
.swiftpm/xcode/xcshareddata/*
!.swiftpm/xcode/xcshareddata/xcschemes
.swiftpm/xcode/xcshareddata/xcschemes/*
!.swiftpm/xcode/xcshareddata/xcschemes/BlazeDBBenchmarks.xcscheme
!.swiftpm/xcode/xcshareddata/xcschemes/blazedb.xcscheme
!.swiftpm/xcode/xcshareddata/xcschemes/BlazeDBCore.xcscheme
Package.resolved

# Xcode junk
*.xcuserdatad/
*.xcworkspace/xcuserdata/
*.xcuserdata/
*.xcuserstate

# Derived data
DerivedData/

# macOS
.DS_Store

# Claude Code / AI tooling
.claude/
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/cli.json
.artifacts/
.logs/
.tagcheck-*.log
Docs/superpowers/
Docs/Benchmarks/logs/

# Android Gradle sample (Examples/android)
Examples/android/.gradle/
Examples/android/**/build/
Examples/android/app/.cxx/

# Secrets and certificates
*.pem
*.key
*.p12
*.cer
.env
.env.*

# Local agent / host toolchain caches (not product sources)
.blaze/
.swift-host/

# Runtime DB files from local example / tool runs (not checked-in fixtures;
# fixtures use other names under Tests/ — do not broaden to *.db / *.json)
*.blaze
